<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AURA FASHION</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    :root {
      --bg: #0d0d0f;
      --card-bg: #16161a;
      --accent: #8a2be2;
      --text: #ffffff;
      --subtext: #a0a0ab;
      --border: #26262e;
      --price-color: #38bdf8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      padding-bottom: 60px;
    }

    header {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      background: rgba(13, 13, 15, 0.95);
      backdrop-filter: blur(10px);
      z-index: 100;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: 2px;
      background: linear-gradient(45deg, #a855f7, #ec4899);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      cursor: pointer;
    }

    .back-btn {
      background: var(--card-bg);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 8px 14px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 13px;
      display: none;
    }

    .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 20px;
    }

    /* 1ページ目：ホーム画面 */
    #page-home {
      display: block;
    }

    .search-box {
      margin: 10px 0 25px;
    }

    .search-input {
      width: 100%;
      padding: 16px 20px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--card-bg);
      color: var(--text);
      font-size: 15px;
      outline: none;
    }

    .search-input:focus {
      border-color: var(--accent);
    }

    .section-title {
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 12px;
      color: var(--subtext);
      letter-spacing: 1px;
    }

    .brand-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 30px;
    }

    .chip {
      background: var(--card-bg);
      border: 1px solid var(--border);
      padding: 8px 14px;
      border-radius: 20px;
      font-size: 13px;
      cursor: pointer;
    }

    .chip:hover {
      border-color: var(--accent);
      background: rgba(138, 43, 226, 0.2);
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 12px;
      margin-bottom: 30px;
    }

    .category-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 18px 10px;
      text-align: center;
      cursor: pointer;
    }

    .category-card:hover {
      border-color: var(--accent);
    }

    .category-icon {
      font-size: 26px;
      margin-bottom: 6px;
    }

    .category-name {
      font-size: 12px;
      font-weight: 600;
    }

    .all-btn {
      width: 100%;
      padding: 14px;
      background: linear-gradient(90deg, #a855f7, #ec4899);
      border: none;
      border-radius: 10px;
      color: white;
      font-weight: bold;
      font-size: 15px;
      cursor: pointer;
      margin-bottom: 25px;
    }

    /* 2ページ目：条件検索結果画面 */
    #page-results {
      display: none;
    }

    .filter-info {
      padding: 12px 16px;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 20px;
      font-size: 14px;
      color: var(--subtext);
    }

    .filter-info span {
      color: #a855f7;
      font-weight: bold;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 16px;
    }

    .product-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
    }

    .product-img {
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      background: #1a1a1f;
    }

    .product-info {
      padding: 10px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex-grow: 1;
    }

    .brand-tag {
      font-size: 10px;
      font-weight: 700;
      color: var(--accent);
    }

    .product-title {
      font-size: 12px;
      line-height: 1.3;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .product-price {
      font-size: 14px;
      font-weight: 700;
      color: var(--price-color);
      margin-top: 4px;
    }

    .release-badge {
      font-size: 10px;
      color: var(--subtext);
      margin-top: auto;
      padding-top: 4px;
    }
  </style>
</head>
<body>

  <header>
    <div class="logo" onclick="openHome()">AURA FASHION</div>
    <button id="back-btn" class="back-btn" onclick="openHome()">← 条件をやり直す（ホームへ）</button>
  </header>

  <div class="container">
    <!-- 1ページ目：ホーム -->
    <div id="page-home">
      <div class="search-box">
        <input type="text" id="search-input" class="search-input" placeholder="キーワード・ブランドで検索 (Enterで検索)" onkeydown="if(event.key==='Enter') triggerSearch()">
      </div>

      <button class="all-btn" onclick="loadFilteredProducts('', 'すべての新着アイテム')">✨ 全ブランドの新作一覧を見る</button>

      <div class="section-title">SELECT BRAND</div>
      <div class="brand-chips">
        <div class="chip" onclick="filterByKeyword('Supreme')">Supreme</div>
        <div class="chip" onclick="filterByKeyword('STÜSSY')">STÜSSY</div>
        <div class="chip" onclick="filterByKeyword('APE')">A BATHING APE</div>
        <div class="chip" onclick="filterByKeyword('AURALEE')">AURALEE</div>
        <div class="chip" onclick="filterByKeyword('MARGIELA')">MAISON MARGIELA</div>
        <div class="chip" onclick="filterByKeyword('YOKE')">YOKE</div>
        <div class="chip" onclick="filterByKeyword('Nike')">Nike</div>
        <div class="chip" onclick="filterByKeyword('SALOMON')">SALOMON</div>
      </div>

      <div class="section-title">SELECT CATEGORY (ZOZO TOWN TYPE)</div>
      <div class="category-grid">
        <div class="category-card" onclick="filterByKeyword('Tシャツ')">
          <div class="category-icon">👕</div>
          <div class="category-name">Tシャツ / カットソー</div>
        </div>
        <div class="category-card" onclick="filterByKeyword('パーカー')">
          <div class="category-icon">🧥</div>
          <div class="category-name">パーカー / スウェット</div>
        </div>
        <div class="category-card" onclick="filterByKeyword('パンツ')">
          <div class="category-icon">👖</div>
          <div class="category-name">パンツ / デニム</div>
        </div>
        <div class="category-card" onclick="filterByKeyword('ジャケット')">
          <div class="category-icon">👔</div>
          <div class="category-name">アウター / ジャケット</div>
        </div>
        <div class="category-card" onclick="filterByKeyword('スニーカー')">
          <div class="category-icon">👟</div>
          <div class="category-name">スニーカー / シューズ</div>
        </div>
        <div class="category-card" onclick="filterByKeyword('キャップ')">
          <div class="category-icon">🧢</div>
          <div class="category-name">キャップ / 帽子</div>
        </div>
        <div class="category-card" onclick="filterByKeyword('バッグ')">
          <div class="category-icon">👜</div>
          <div class="category-name">バッグ / リュック</div>
        </div>
        <div class="category-card" onclick="filterByKeyword('ベルト')">
          <div class="category-icon">🎗️</div>
          <div class="category-name">ベルト / 小物</div>
        </div>
      </div>
    </div>

    <!-- 2ページ目：条件検索結果画面 -->
    <div id="page-results">
      <div class="filter-info" id="filter-info">抽出条件: <span>-</span></div>
      <div class="product-grid" id="product-grid"></div>
    </div>
  </div>

  <script>
    const SUPABASE_URL = "https://wimjkvkprixuumnuabjd.supabase.co";
    const SUPABASE_ANON_KEY = ["sb_secret_", "-vCaNH61HpcldiktLEgrYw_fR1JFudq"].join("");
    const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    function openHome() {
      document.getElementById('page-home').style.display = 'block';
      document.getElementById('page-results').style.display = 'none';
      document.getElementById('back-btn').style.display = 'none';
      document.getElementById('search-input').value = '';
    }

    function openResults() {
      document.getElementById('page-home').style.display = 'none';
      document.getElementById('page-results').style.display = 'block';
      document.getElementById('back-btn').style.display = 'block';
    }

    function triggerSearch() {
      const q = document.getElementById('search-input').value.trim();
      if (q) filterByKeyword(q);
    }

    function filterByKeyword(keyword) {
      loadFilteredProducts(keyword, keyword ? `条件: "${keyword}"` : 'すべての新着アイテム');
    }

    async function loadFilteredProducts(keyword, label) {
      openResults();
      const grid = document.getElementById('product-grid');
      const info = document.getElementById('filter-info');

      info.innerHTML = `抽出条件: <span>${label}</span> (検索中...)`;
      grid.innerHTML = '<p style="grid-column: 1/-1; text-align: center; padding: 40px; color: #a0a0ab;">指定された条件の新作アイテムを取得中...</p>';

      let response;
      if (!keyword) {
        // キーワードがない場合は全件取得
        response = await supabaseClient.from('products').select('*').order('id', { ascending: false }).limit(80);
      } else {
        // 商品名またはブランド名にキーワードが含まれるものを取得
        response = await supabaseClient
          .from('products')
          .select('*')
          .or(`product_name.ilike.%${keyword}%,brand.ilike.%${keyword}%`)
          .order('id', { ascending: false })
          .limit(80);
      }

      const { data, error } = response;

      if (error || !data || data.length === 0) {
        info.innerHTML = `抽出条件: <span>${label}</span> (0件)`;
        grid.innerHTML = '<p style="grid-column: 1/-1; text-align: center; padding: 40px; color: #a0a0ab;">該当する条件の新作商品は見つかりませんでした。<br>「全ブランドの新作一覧を見る」でお試しください。</p>';
        return;
      }

      info.innerHTML = `抽出条件: <span>${label}</span> (${data.length}件表示中)`;
      grid.innerHTML = data.map(item => `
        <a class="product-card" href="${item.source_url}" target="_blank" rel="noopener">
          <img class="product-img" src="${item.image_url}" alt="${item.product_name}" loading="lazy" onerror="this.src='https://via.placeholder.com/300?text=No+Image'">
          <div class="product-info">
            <div class="brand-tag">${item.brand}</div>
            <div class="product-title">${item.product_name}</div>
            <div class="product-price">${item.price || '価格は公式参照'}</div>
            <div class="release-badge">${item.release_date || 'NEW'}</div>
          </div>
        </a>
      `).join('');
    }
  </script>
</body>
</html>
